# Generated WASM/build output. Release artifacts are deliberately force-added
# only after they are named, hashed, licensed, and tested in a provider package.
*.wasm
!providers/**/artifacts/**/*.wasm
target/
build/
dist/
vendor/
*.o
*.a
*.so
*.dylib
*.dll

# Downloaded upstream source and local tool caches.
_upstream/
.cache/

# Local credentials and configuration.
.env

# Editor / OS noise.
.DS_Store
*~

# Provider build output. A released artifact is force-added with its checksum.
providers/*/adapter/target/
providers/*/adapter/embedded.wasm
providers/*/tests/*.wasm
